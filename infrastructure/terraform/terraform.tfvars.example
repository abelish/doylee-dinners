# Copy this file to terraform.tfvars and update with your values
# DO NOT commit terraform.tfvars to git

project_name = "doylee-dinners"
environment  = "prod"
aws_region   = "us-west-2"

# DynamoDB configuration
dynamodb_billing_mode = "PAY_PER_REQUEST" # Free tier friendly

# Lambda configuration
lambda_runtime     = "nodejs20.x"
lambda_memory_size = 256
lambda_timeout     = 10

# JWT secret - CHANGE THIS to a secure random string
jwt_secret = "CHANGE-ME-TO-A-SECURE-RANDOM-STRING-AT-LEAST-32-CHARACTERS"

# Frontend domain (optional)
frontend_domain_name = "" # Leave empty to use CloudFront domain

# Tags
tags = {
  Project     = "doylee-dinners"
  Environment = "prod"
  ManagedBy   = "terraform"
}
